pipeline {
    agent any

    tools {
        maven 'Maven3'
        jdk 'JDK'
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'master',
                    url: 'https://github.com/Yash28102/Wipro_Training-'
            }
        }

        stage('Build') {
            steps {
                dir('Cucumberdemo') {
                    bat 'mvn clean'
                }
            }
        }

        stage('Compile') {
            steps {
                dir('Cucumberdemo') {
                    bat 'mvn compile'
                }
            }
        }

        stage('Test') {
            steps {
                dir('Cucumberdemo') {
                    bat 'mvn test'
                }
            }
        }

        stage('Package') {
            steps {
                dir('Cucumberdemo') {
                    bat 'mvn package'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('Cucumberdemo') {
                    bat 'docker build -t cucumber-project .'
                }
            }
        }
    }

    post {

        always {
            junit allowEmptyResults: true,
                  testResults: '**/target/surefire-reports/*.xml'

            archiveArtifacts artifacts: '**/target/**/*',
                             fingerprint: true
        }

        success {
            echo 'Build Successful'
        }

        failure {
            echo 'Build Failed'
        }
    }
}
